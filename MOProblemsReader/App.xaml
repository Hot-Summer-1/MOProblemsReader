<Application x:Class="MOProblemsReader.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MOProblemsReader"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="MainWindow.xaml"
             ThemeMode="System"
             Exit="Application_Exit"
             Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    只合并独立的进度条样式字典：其中不含 Menu/TreeView/Button 等控件的隐式样式，
                    因此主窗口其余控件仍保持原生 WPF 外观。
                -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.ProgressBar.xaml" />
                <!--
                    BundledTheme 只提供 PrimaryHueMidBrush 等配色画刷，供进度条样式内部 DynamicResource 引用。
                    切勿合并 MaterialDesign2.Defaults.xaml / MaterialDesign3.Defaults.xaml —— 那是全量字典，会接管整个应用外观。
                -->
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="DeepPurple"
                                             SecondaryColor="Lime" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
