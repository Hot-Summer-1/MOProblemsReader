<Window x:Class="MOProblemsReader.RepositorySettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:log="clr-namespace:Serilog.Events;assembly=Serilog"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:local="clr-namespace:MOProblemsReader"
        mc:Ignorable="d"
        Title="设置" Height="250" Width="700"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Loaded="Window_Loaded">
    <Window.Resources>
        <ObjectDataProvider x:Key="StatusValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="log:LogEventLevel"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>

            <ColumnDefinition></ColumnDefinition>

            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>

        </Grid.ColumnDefinitions>
        <!-- 标签右侧留出空隙，避免与第一列最末尾的状态指示器贴在一起 -->
        <TextBlock Text="题源URL:" VerticalAlignment="Center" Margin="0,0,18,0" Grid.Row="0" Grid.Column="0"/>
        <TextBox Name="RepositoryURLTextBox"
                 Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="6"
                 VerticalAlignment="Center"
                 TextChanged="RepositoryURLTextBox_TextChanged"/>
        <!--
            检查状态指示器固定在「第一列（题源URL 标签列）的最末尾」，三个控件靠 Visibility 互斥显示。
            转圈复用 MaterialDesign 的环形进度条样式（App.xaml 已合并该样式字典），
            不要写成 materialDesign:CircularProgressBar —— 该标记在 5.2.1 中未导出。
        -->
        <ProgressBar Name="CheckProgressBar"
                     Grid.Row="0" Grid.Column="0"
                     IsIndeterminate="True"
                     Style="{DynamicResource MaterialDesignCircularProgressBar}"
                     Width="16" Height="16"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"
                     Margin="0,0,4,0"
                     Foreground="{DynamicResource SystemAccentBrush}"
                     Visibility="Collapsed"
                     IsHitTestVisible="False"/>
        <TextBlock Name="CheckOkTextBlock"
                   Grid.Row="0" Grid.Column="0"
                   Text="✓"
                   FontWeight="Bold"
                   Foreground="Green"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Margin="0,0,6,0"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"/>
        <TextBlock Name="CheckFailTextBlock"
                   Grid.Row="0" Grid.Column="0"
                   Text="✗"
                   FontWeight="Bold"
                   Foreground="Red"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Margin="0,0,6,0"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"/>
        <Button Content="检查" Grid.Row="0" Grid.Column="7" VerticalAlignment="Center" HorizontalAlignment="Center" Width="60" Click="CheckButton_OnClick"/>
        <Button Content="更新(_U)" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Click="UpdateButton_Click"/>
        <CheckBox Name="AutoUpdateCheckBox" Content="启用自动更新"  Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="4" Grid.Column="0" Text="日志级别:"  VerticalAlignment="Center"/>
        <ComboBox Grid.Row="4"  HorizontalAlignment="Left" Grid.ColumnSpan="2" Grid.Column="1" Name="LogLevelComboBox" ItemsSource="{Binding Source={StaticResource StatusValues}}"/>
        <Button Content="确定" Grid.Row="5" Grid.Column="5" Width="75" VerticalAlignment="Bottom" Style="{DynamicResource AccentButtonStyle}" IsDefault="True" Click="ConfirmButton_Click"/>
        <Button Content="取消" Grid.Row="5" Grid.Column="6" Width="75" VerticalAlignment="Bottom" Click="CancelButton_Click"/>
        <Button Content="应用" Grid.Row="5" Grid.Column="7" Width="75" VerticalAlignment="Bottom" Style="{DynamicResource AccentButtonStyle}" Click="ApplyButton_Click"/>
        <Button Content="导出诊断数据" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Click="ExportButton_OnClick" />
    </Grid>
</Window>
